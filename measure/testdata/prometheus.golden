api_latency_seconds_bucket{endpoint="create",le="0.25"} 0
api_latency_seconds_bucket{endpoint="create",le="1"} 0
api_latency_seconds_bucket{endpoint="create",le="+Inf"} 1
api_latency_seconds_sum{endpoint="create"} 5
api_latency_seconds_count{endpoint="create"} 1
