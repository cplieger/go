go_memstats_gc_sys_bytes <value>
# HELP go_memstats_heap_alloc_bytes Number of heap bytes allocated and currently in use.
# TYPE go_memstats_heap_alloc_bytes gauge
go_memstats_heap_alloc_bytes <value>
# HELP go_memstats_heap_idle_bytes Bytes of heap memory with no objects in it, free or released.
# TYPE go_memstats_heap_idle_bytes gauge
go_memstats_heap_idle_bytes <value>
# HELP go_memstats_heap_inuse_bytes Bytes of heap memory in spans that hold objects.
