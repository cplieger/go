api_latency_seconds_bucket{endpoint="list",le="1"} 2
api_latency_seconds_bucket{endpoint="list",le="+Inf"} 2
api_latency_seconds_sum{endpoint="list"} 0.6
api_latency_seconds_count{endpoint="list"} 2
# HELP go_gc_duration_seconds Stop-the-world pause durations of recent garbage collections in seconds.
# TYPE go_gc_duration_seconds summary
go_gc_duration_seconds{quantile="0"} <value>
go_gc_duration_seconds{quantile="0.25"} <value>
go_gc_duration_seconds{quantile="0.5"} <value>
go_gc_duration_seconds{quantile="0.75"} <value>
go_gc_duration_seconds{quantile="1"} <value>
go_gc_duration_seconds_sum <value>
go_gc_duration_seconds_count <value>
# HELP go_gc_gogc_percent The GOGC setting: the heap growth percentage that triggers a collection.
# TYPE go_gc_gogc_percent gauge
go_gc_gogc_percent <value>
# HELP go_gc_gomemlimit_bytes The GOMEMLIMIT setting: the Go runtime's soft memory limit in bytes.
# TYPE go_gc_gomemlimit_bytes gauge
go_gc_gomemlimit_bytes <value>
# HELP go_goroutines Number of goroutines that currently exist.
# TYPE go_goroutines gauge
go_goroutines <value>
# HELP go_info Information about the Go environment, with the Go version as a label.
# TYPE go_info gauge
go_info{version="<version>"} <value>
# HELP go_memstats_alloc_bytes Bytes of allocated heap objects, the same value as go_memstats_heap_alloc_bytes.
# TYPE go_memstats_alloc_bytes gauge
go_memstats_alloc_bytes <value>
# HELP go_memstats_alloc_bytes_total Total bytes allocated on the heap, including freed objects.
# TYPE go_memstats_alloc_bytes_total counter
go_memstats_alloc_bytes_total <value>
# HELP go_memstats_buck_hash_sys_bytes Bytes of memory in profiling bucket hash tables.
# TYPE go_memstats_buck_hash_sys_bytes gauge
go_memstats_buck_hash_sys_bytes <value>
# HELP go_memstats_frees_total Total heap objects freed.
# TYPE go_memstats_frees_total counter
go_memstats_frees_total <value>
# HELP go_memstats_gc_sys_bytes Bytes of memory in garbage collection metadata.
