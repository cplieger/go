go_memstats_heap_inuse_bytes <value>
# HELP go_memstats_heap_objects Number of allocated heap objects.
# TYPE go_memstats_heap_objects gauge
go_memstats_heap_objects <value>
# HELP go_memstats_heap_released_bytes Bytes of heap memory returned to the operating system.
# TYPE go_memstats_heap_released_bytes gauge
go_memstats_heap_released_bytes <value>
# HELP go_memstats_heap_sys_bytes Bytes of heap memory obtained from the operating system.
# TYPE go_memstats_heap_sys_bytes gauge
go_memstats_heap_sys_bytes <value>
