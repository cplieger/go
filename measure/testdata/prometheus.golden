# TYPE tasks_total counter
tasks_total 42
# HELP events Total events
# TYPE events counter
events 5
# HELP queue_depth Items queued
# TYPE queue_depth gauge
queue_depth{queue="egress"} 0.5
queue_depth{queue="ingest"} 12
