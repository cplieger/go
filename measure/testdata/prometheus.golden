go_memstats_mspan_inuse_bytes <value>
# HELP go_memstats_mspan_sys_bytes Bytes of memory obtained for mspan structures.
# TYPE go_memstats_mspan_sys_bytes gauge
go_memstats_mspan_sys_bytes <value>
