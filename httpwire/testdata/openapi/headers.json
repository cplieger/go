          },
          {
            "in": "header",
            "name": "grelot-self",
            "required": false,
            "schema": {
              "enum": ["1"],
              "type": "string",
              "x-max-bytes": 1
            }
          },
          {
            "in": "header",
            "name": "X-Slot",
            "required": false,
            "schema": {
              "maximum": 9,
