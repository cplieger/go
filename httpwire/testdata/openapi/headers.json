{
  "info": {
    "title": "headers fixture",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/agents": {
      "get": {
        "description": "Reads the calling agent.",
        "operationId": "agents.get",
        "parameters": [
          {
            "in": "header",
            "name": "Grelot-Session",
            "required": true,
            "schema": {
              "minLength": 3,
              "type": "string",
              "x-max-bytes": 8
            }
          },
          {
            "in": "header",
            "name": "Grelot-As",
            "required": false,
            "schema": {
              "type": "string",
              "x-max-bytes": 4
            }
          },
          {
            "in": "header",
            "name": "grelot-self",
            "required": false,
            "schema": {
              "enum": ["1"],
              "type": "string",
              "x-max-bytes": 1
            }
          },
          {
            "in": "header",
            "name": "X-Slot",
            "required": false,
            "schema": {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Env",
            "required": false,
            "schema": {
              "type": "string",
              "x-max-bytes": 4
            }
          },
          {
            "in": "header",
            "name": "X-Count",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Fast",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "summary": "Read the agent"
      }
    },
    "/api/agents/act": {
      "post": {
        "description": "Runs one action as the calling agent.",
        "operationId": "agents.act",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Grelot-Session",
            "required": true,
            "schema": {
              "minLength": 3,
              "type": "string",
              "x-max-bytes": 8
            }
          },
          {
            "in": "header",
            "name": "Grelot-As",
            "required": false,
            "schema": {
              "type": "string",
              "x-max-bytes": 4
            }
          },
          {
            "in": "header",
            "name": "grelot-self",
            "required": false,
            "schema": {
              "enum": ["1"],
              "type": "string",
              "x-max-bytes": 1
            }
          },
          {
            "in": "header",
            "name": "X-Slot",
            "required": false,
            "schema": {
              "maximum": 9,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Env",
            "required": false,
            "schema": {
              "type": "string",
              "x-max-bytes": 4
            }
          },
          {
            "in": "header",
            "name": "X-Count",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Fast",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string",
                    "x-max-bytes": 8
                  }
                },
                "required": ["name"],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": ["id"],
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Act as the agent",
        "x-idempotency": {
          "concurrent": "join",
          "kept": "success_and_effectful_refusals",
          "scope": "credential,operation",
          "window_s": 600
        }
      }
    },
