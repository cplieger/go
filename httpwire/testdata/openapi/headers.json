          {
            "in": "header",
            "name": "X-Count",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Fast",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {}
              }
            },
            "description": "OK"
          }
        },
        "summary": "Download the agent's file"
      }
    },
    "/api/agents/watch": {
      "get": {
        "description": "Streams the calling agent's events.",
        "operationId": "agents.watch",
        "parameters": [
          {
            "in": "header",
            "name": "Grelot-Session",
            "required": true,
            "schema": {
              "minLength": 3,
              "type": "string",
