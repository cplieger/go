          },
          {
            "in": "header",
            "name": "X-Count",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "X-Fast",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-events": {
                  "seen": {
                    "properties": {
                      "at": {
                        "type": "integer"
                      }
                    },
                    "required": ["at"],
                    "type": "object"
                  }
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Watch the agent"
      }
    },
    "/api/agents/{kind}": {
      "post": {
        "description": "Posts one message to an agent.",
        "operationId": "agents.post",
        "parameters": [
          {
            "in": "path",
            "name": "kind",
            "required": true,
            "schema": {
              "enum": ["book", "disc"],
              "type": "string",
              "x-max-bytes": 16
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": true,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Grelot-Session",
            "required": true,
            "schema": {
              "minLength": 3,
